{
  "name": "ar-world-map",
  "private": true,
  "version": "1.0.0",
  "description": "WebAR world-map experience (MindAR + Three.js) with an admin dashboard, hosted on Netlify.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:full": "npm run compile-target && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile-target": "node scripts/compile-target.mjs",
    "netlify:dev": "netlify dev"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "mind-ar": "^1.2.5",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.2",
    "@types/node": "^22.10.2",
    "@types/three": "0.160.0",
    "puppeteer": "^25.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "canvas": "npm:@napi-rs/canvas@^0.1.0"
  },
  "allowScripts": {
    "puppeteer@25.1.0": true,
    "core-js@3.29.1": true,
    "esbuild@0.25.12": true
  }
}
